# Canonical origin, no trailing slash. Set this in Vercel before launch.
# The fallback in lib/site.ts is a placeholder and must not be used in production.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Cloudflare Web Analytics token (optional). The beacon only renders when set.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# Search console verification (optional). Emitted only when set.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Affiliate destination overrides (server-only, optional).
# /go/<slug> uses these when present; otherwise it falls back to the tool's
# official sourceUrl with UTM parameters. Apply for programs before filling in.
AFFILIATE_CANVA=
AFFILIATE_CLIPCHAMP=
AFFILIATE_KAPWING=
AFFILIATE_VEED=
AFFILIATE_DESCRIPT=
AFFILIATE_INVIDEO=
AFFILIATE_ADOBE_EXPRESS=
AFFILIATE_CAPCUT_WEB=

# IndexNow key for scripts/indexnow.mjs. The script expects
# public/<INDEXNOW_KEY>.txt to be deployed at the site root.
INDEXNOW_KEY=
